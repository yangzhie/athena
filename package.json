{
  "name": "athena",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/playground",
    "packages/playground"
  ],
  "scripts": {
    "dev": "npm run dev -w @athena/web",
    "build": "npm run build -w @athena/web",
    "lint": "npm run lint -w @athena/web",
    "preview": "npm run preview -w @athena/web",
    "dev:playground": "npm run dev -w @athena/playground-demo",
    "build:playground": "npm run build -w @athena/playground-demo",
    "lint:playground": "npm run lint -w @athena/playground && npm run typecheck -w @athena/playground && npm run lint -w @athena/playground-demo",
    "contracts:generate": "apps/api/.venv/bin/python scripts/generate-contracts.py",
    "contracts:check": "npm run contracts:generate && git diff --exit-code -- packages/shared",
    "dev:all": "python3 scripts/dev.py",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "openapi-typescript": "^7.13.0",
    "ts-json-schema-generator": "^2.9.0"
  }
}
